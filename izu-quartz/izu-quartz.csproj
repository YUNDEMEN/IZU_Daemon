<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>izu_quartz</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="quartz_jobs.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="quartz_jobs.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Quartz">
      <HintPath>..\..\..\Repos\quartznet\msbuild-release-net8.0\Quartz.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Jobs">
      <HintPath>..\..\..\Repos\quartznet\msbuild-release-net8.0\Quartz.Jobs.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Plugins">
      <HintPath>..\..\..\Repos\quartznet\msbuild-release-net8.0\Quartz.Plugins.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Serialization.Newtonsoft">
      <HintPath>..\..\..\Repos\quartznet\msbuild-release-net8.0\Quartz.Serialization.Newtonsoft.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
