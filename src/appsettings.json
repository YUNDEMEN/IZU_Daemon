{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "urls": "http://localhost:8000", //端口 ------更改后必须重启服务生效
  "AllowedHosts": "*",
  "izu": {
    "name": "izu 001", //izu名称
    "server": "127.0.0.1", //本地内网IP地址，用于外部调用接口、连接websocket使用
    "recoverySeconds": 20, //灾后重启时间 ------更改后必须重启服务生效
    "deviceFiles": "DeviceTable", //变量表存放文件夹（单文件、多文件）
    "sampleFiles": "SampleData", //测试数据存放文件夹
    "refreshMillionSeconds": 200, //从设备读取数据的时间间隔（毫秒）
    "izu_backend": "http://192.168.127.118:8030/v1.0/" //调用接口，上传IZU信息到数据
  }
}