{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    },
    "ColorConsole": {
      "LogLevelToColorMap": {
        "Debug": "Gray",
        "Information": "Green",
        "Warning": "Yellow",
        "Error": "Magenta",
        "Critical": "Red"
      }
    }
  },
  "AllowedHosts": "*",
  "izu_backend": "http://192.168.127.118:8030/v1.0/", //调用接口，上传IZU信息到数据
  "websocket_pub_interval": 50, //websocket发布数据的时间间隔（毫秒）
  "refreshMillionSeconds": 50, //从设备读取数据的时间间隔（毫秒）
}