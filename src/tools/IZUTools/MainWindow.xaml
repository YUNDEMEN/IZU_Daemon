<Window x:Class="IZUTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IZUTools"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        Title="IZU Tools" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="5,5,5,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Menu FontSize="14">
            <MenuItem Header="文件">
                <MenuItem Header="打开" Click="Open_Click"/>
                <Separator/>
                <MenuItem Header="退出"/>
            </MenuItem>
        </Menu>
        <ContentControl x:Name="ToolContent" Grid.Row="1"/>
    </Grid>
</Window>
