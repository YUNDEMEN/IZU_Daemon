<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\8008249.ico</ApplicationIcon>
    <RootNamespace>OHTC.Tools</RootNamespace>
    <AssemblyName>IZU-Tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <None Remove="build\**" />
    <Page Remove="build\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="ControlPages\Cycle-DummyView.xaml.cs" />
    <Compile Remove="ControlPages\CycleConfigView.xaml.cs" />
    <Compile Remove="CycleDummyTest.cs" />
    <Compile Remove="CycleTransferTest.cs" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="ControlPages\Cycle-DummyView.xaml" />
    <Page Remove="ControlPages\CycleConfigView.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="ModernWpfUI.MahApps" Version="0.9.5" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NanoMsgCore">
      <HintPath>..\..\..\references\SDK\NanoMsgCore.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\..\references\Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="oht_task.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="x64\libnanomsg.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x64\nanomsg.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x86\libnanomsg.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x86\nanomsg.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
