<Window
    x:Class="OHTC.Tools.TransferScheduleWindow"
    x:Name="Window"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:local="clr-namespace:OHTC.Tools"
    xmlns:sc="clr-namespace:SamplesCommon"
    mc:Ignorable="d"
    Title="Custom Title Bar"
    Width="914"
    Height="686"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource SystemControlPageBackgroundChromeMediumLowBrush}"
    ui:WindowHelper.UseModernWindowStyle="True"
    ui:TitleBar.ExtendViewIntoTitleBar="True"
    ui:TitleBar.IsBackButtonVisible="True"
    ui:TitleBar.Style="{DynamicResource AppTitleBarStyle}"
    ui:TitleBar.ButtonStyle="{DynamicResource AppTitleBarButtonStyle}"
    ui:TitleBar.BackButtonStyle="{DynamicResource AppTitleBarBackButtonStyle}"
    xmlns:app="clr-namespace:OHTC.Tools">

    <Window.Resources>
        <sc:PixelsToGridLengthConverter x:Key="PixelsToGridLength" />
        <app:BooleanReverseConverter x:Key="BooleanReverseConverter" />
        <Style TargetType="HeaderedContentControl">
            <Setter Property="Margin" Value="0,0,0,28" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                    Margin="0,0,0,16"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ui:SimpleStackPanel">
            <Setter Property="Spacing" Value="12" />
        </Style>
        <Style x:Key="AppTitleBarStyle" TargetType="ui:TitleBarControl">
            <Setter Property="ui:ThemeManager.RequestedTheme" Value="Dark" />
        </Style>
        <Style x:Key="AppTitleBarButtonStyle" TargetType="ui:TitleBarButton">
            <Setter Property="IsActive" Value="{Binding IsActive, ElementName=Window}" />
        </Style>
        <Style x:Key="AppTitleBarBackButtonStyle" TargetType="ui:TitleBarButton" BasedOn="{StaticResource TitleBarBackButtonStyle}">
            <Setter Property="IsActive" Value="{Binding IsActive, ElementName=Window}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Background="{DynamicResource SystemControlBackgroundAccentBrush}"
            Height="{Binding ElementName=Window, Path=(ui:TitleBar.Height)}"
            ui:ThemeManager.RequestedTheme="Dark">

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive, ElementName=Window}" Value="False">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ElementName=Window, Path=(ui:TitleBar.SystemOverlayLeftInset), Converter={StaticResource PixelsToGridLength}}" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding ElementName=Window, Path=(ui:TitleBar.SystemOverlayRightInset), Converter={StaticResource PixelsToGridLength}}" />
            </Grid.ColumnDefinitions>

            <!-- Horizontally centered title -->
            <TextBlock
                Grid.Column="0"
                Grid.ColumnSpan="5"
                FontSize="13"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding ElementName=Window, Path=Title}" />

        </Grid>

        <Grid Margin="10" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid
          Margin="0,40,5,0"
          DataContext="{Binding CurrentCommand}"
          TextElement.FontSize="16">
                <ui:AppBarButton
              Width="42"
              Height="42"
              Margin="0,0,0,0"
              HorizontalAlignment="Right"
              Click="Reload_Click">
                    <ui:AppBarButton.Icon>
                        <ui:FontIcon Glyph="&#xE117;" />
                    </ui:AppBarButton.Icon>
                </ui:AppBarButton>
                <HeaderedContentControl Margin="0,30,0,0" Header="Station">
                    <ui:SimpleStackPanel>
                        <DockPanel>
                            <TextBlock
                          Width="120"
                          VerticalAlignment="Center"
                          Text="From Station" />
                            <TextBox
                          x:Name="tb_from"
                          Width="180"
                          Margin="10,0,0,0" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock
                          Width="120"
                          VerticalAlignment="Center"
                          Text="To Station" />
                            <TextBox
                          x:Name="tb_to"
                          Width="180"
                          Margin="10,0,0,0" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock
                          Width="120"
                          VerticalAlignment="Center"
                          Text="OHT:" />
                            <TextBox
                          x:Name="OHT_ID"
                          Width="180"
                          Margin="10,0,0,0" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock
                          Width="120"
                          VerticalAlignment="Center"
                          Text="Duration" />
                            <TextBlock
                          Width="20"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center"
                          DockPanel.Dock="Right"
                          Text="s" />
                            <TextBox
                          x:Name="tb_sec"
                          Width="180"
                          Margin="30,0,0,0" />
                        </DockPanel>
                        <Button
                      Width="100"
                      Height="60"
                      Margin="0,30,0,0"
                      HorizontalAlignment="Left"
                      Click="Add_Click"
                      Content="  Add Task  "
                      IsEnabled="{Binding IsRunning, Converter={StaticResource BooleanReverseConverter}}" />
                    </ui:SimpleStackPanel>
                </HeaderedContentControl>
            </Grid>
            <DockPanel Grid.Column="1" Margin="5,0,0,0">
                <ListBox
              x:Name="lb"
              ItemContainerStyle="{StaticResource ListBoxItemCommandStyle}"
              ItemsSource="{Binding OhtCommandList}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                          Height="60"
                          CornerRadius="2"
                          TextElement.FontSize="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="0.2*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  FontFamily="Verdana"
                                  Text="{Binding SourceStation}" />
                                    <TextBlock
                                  Grid.Column="2"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  FontFamily="Verdana"
                                  Text="{Binding DestStation}" />
                                    <TextBlock
                                  Grid.Column="3"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  FontFamily="Verdana"
                                  Text="{Binding DurationSecond, StringFormat=0s}" />
                                    <ui:AppBarButton
                                  Grid.Column="4"
                                  VerticalAlignment="Center"
                                  Click="Delete_Click"
                                  Label="Delete">
                                        <ui:AppBarButton.Icon>
                                            <ui:FontIcon Glyph="&#xE107;" />
                                        </ui:AppBarButton.Icon>
                                    </ui:AppBarButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

    </Grid>
</Window>
