<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RootNamespace>$(MSBuildProjectName.Replace("_Daemon", ""))</RootNamespace>
    <AssemblyName>$(MSBuildProjectName.Replace("_Daemon", "-Service"))</AssemblyName>
    <SatelliteResourceLanguages>disabled</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="build\**" />
    <Compile Remove="Commands\**" />
    <Compile Remove="Controllers\**" />
    <Compile Remove="DeviceTable\**" />
    <Compile Remove="Interfaces\**" />
    <Compile Remove="Service\**" />
    <Content Remove="build\**" />
    <Content Remove="Commands\**" />
    <Content Remove="Controllers\**" />
    <Content Remove="DeviceTable\**" />
    <Content Remove="Interfaces\**" />
    <Content Remove="Service\**" />
    <EmbeddedResource Remove="build\**" />
    <EmbeddedResource Remove="Commands\**" />
    <EmbeddedResource Remove="Controllers\**" />
    <EmbeddedResource Remove="DeviceTable\**" />
    <EmbeddedResource Remove="Interfaces\**" />
    <EmbeddedResource Remove="Service\**" />
    <None Remove="build\**" />
    <None Remove="Commands\**" />
    <None Remove="Controllers\**" />
    <None Remove="DeviceTable\**" />
    <None Remove="Interfaces\**" />
    <None Remove="Service\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Sharp7.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.8" />
    <PackageReference Include="S7netplus" Version="0.20.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="System.Text.Encoding" Version="4.3.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
    <PackageReference Include="TinyCsvParser" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="NanoMsgCore">
      <HintPath>..\..\..\references\SDK\NanoMsgCore.dll</HintPath>
    </Reference>
    <Reference Include="ServiceFramework">
      <HintPath>..\..\..\references\framework\ServiceFramework.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="x64\libnanomsg.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x64\nanomsg.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x86\libnanomsg.so">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="x86\nanomsg.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\izu_shared\IZU.projitems" Label="Shared" />


</Project>
