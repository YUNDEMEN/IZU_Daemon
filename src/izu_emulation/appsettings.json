{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    },
    "ColorConsole": {
      "LogLevelToColorMap": {
        "Debug": "Gray",
        "Information": "Green",
        "Warning": "Yellow",
        "Error": "Magenta",
        "Critical": "Red"
      }
    }
  },
  "AllowedHosts": "*",
  "izuId": 0, //不用修改，自动获取
  "map_version": "", //不用修改，自动获取

  //修改后需要重启（NANOMSG 无法热更新，修改后需要重启程序）
  "PortNanoCommandServer": 8231, // 接受OSO控制设备指令端口
  "PortNanoDataServer": 18031, // 单点发送设备数据 用于本地上位机客户端程序
  //修改后需要重启

  //热更新
  "multicast_ip": "224.168.100.2", //多播地址
  "PortMulticastServer": 8131, // 多播端口（报文）用于发送设备状态给OSO
  "PortMulticastFullDataServer": 8331, // 多播端口（json数据） 用于前端展示设备状态（izu-oso-backend-frontend）
  "IntervalMulticastServer": 100, // 多播频率（ms）
  "IntervalMulticastFullDataServer": 500, // 多播（json数据）发送设备数据频率（ms）
  "IntervalNanoDataServer": 10, // 单点发送设备数据频率（ms）
  "izu_backend": "http://192.168.127.1:8030/v1.0/", //调用接口，上传IZU信息到数据
  "usecsv": true //启用本地csv变量表
  //热更新
}