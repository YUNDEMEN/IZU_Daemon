<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>izu_quartz</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="jobs.xml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="jobs.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.7" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Quartz">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.AspNetCore">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.AspNetCore.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Jobs">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.Jobs.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Plugins">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.Plugins.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Serialization.Newtonsoft">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.Serialization.Newtonsoft.dll</HintPath>
    </Reference>
    <Reference Include="Quartz.Serialization.SystemTextJson">
      <HintPath>..\..\references\quartz-release-net8.0\Quartz.Serialization.SystemTextJson.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
