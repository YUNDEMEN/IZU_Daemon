{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    },
    "ColorConsole": {
      "LogLevelToColorMap": {
        "Debug": "Gray",
        "Information": "Green",
        "Warning": "Yellow",
        "Error": "Magenta",
        "Critical": "Red"
      }
    }
  },
  "AllowedHosts": "*",
  "izu_backend": "http://127.0.0.1:8030/v1.0/", //调用接口，上传IZU信息到数据
  "map_version": "VNB-V1.6",
  "multicast_ip": "224.168.100.2",
  "PortMulticastServer": 8131, // 多播端口（报文）用于oso接受设备状态
  "IntervalMulticastServer": 100, // 多播频率（ms）
  "PortNanoCommandServer": 8231, // 接受OSO控制设备指令端口
  "PortMulticastFullDataServer": 8331, // 多播端口（json数据） 用于前端展示设备状态（izu-oso-backend-frontend）
  "IntervalMulticastFullDataServer": 500, // 多播（json数据）发送设备数据频率（ms）
  "PortNanoDataServer": 18031, // 单点发送设备数据 用于本地上位机客户端程序
  "IntervalNanoDataServer": 10, // 单点发送设备数据频率（ms）
  "usecsv": true
}